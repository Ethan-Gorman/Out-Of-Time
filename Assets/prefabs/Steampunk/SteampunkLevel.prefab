--- !u!114 &4244265585201119315
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8806204343958611107}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4dc1f43652c70a648aa9da90bce7889f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SteampunkLevel
  gear1: {fileID: 4107074479055597259}
  gear2: {fileID: 2160065077052428426}
  gear3: {fileID: 3750503038461729399}
  lift: {fileID: 2289758242105058798}
  timeMachine: {fileID: 8369986076524456893}
  introDelay: 1.4
  introLines:
  - 'SYSTEM: "Arrival successful. Landing procedure: unsuccessful."'
  - 'PLAYER: "Why am I always falling?"'
  - 'SYSTEM: "Mechanical lift inactive. Three gears require maintenance."'
  gearsObjective: Repair the gear tower to power the lift
  chainLines:
  - 'PLAYER: "A spare iron chain. Gear one is missing exactly this."'
  oilLines:
  - 'PLAYER: "An oil can. That seized gear won''t know what hit it."'
  gear1Lines:
  - 'PLAYER: "Chain''s on. Gear one is turning!"'
  gear2WaitingLines:
  - 'PLAYER: "Oiled and free... but it needs gear one to drive it."'
  gear2Lines:
  - 'PLAYER: "Gear two is moving. And the rod is pulling on gear three..."'
  liftLines:
  - 'SYSTEM: "Gear assembly operational. Mechanical lift online."'
  - 'PLAYER: "Finally. Going up."'
  liftObjective: Ride the lift to the first floor
  firstFloorLines:
  - 'PLAYER: "The time machine is at the far end. Past all of... that."'
  machineObjective: Reach the time machine
  repairedLines:
  - 'SYSTEM: "Time machine condition critical. Chrono Regulator malfunction detected."'
  - 'PLAYER: "You have got to be kidding me."'
  - 'SYSTEM: "Repairs complete. Next destination: Future Era."'
  boardObjective: Board the time machine
  nextEraBanner: 'FUTURE ERA

    <size=36>Coming soon</size>'
  nextSceneName: Future
