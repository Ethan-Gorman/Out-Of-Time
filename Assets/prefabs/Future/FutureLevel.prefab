  - {fileID: 9180035199041572870}
  - {fileID: 4652190020827006314}
  - {fileID: 7426673948178847991}
  - {fileID: 7721446158040907756}
  - {fileID: 5769341770793545144}
  - {fileID: 232402154170729851}
  - {fileID: 3015583485735318709}
  coreOfflineVisuals:
  - {fileID: 4788595124577403689}
  coreOnlineVisuals:
  - {fileID: 1074540917041936345}
  - {fileID: 3390307299044763111}
  coreLight: {fileID: 579555049220801377}
  coreOnlineColor: {r: 0.35, g: 0.9, b: 1, a: 1}
  coreOnlineIntensity: 3
  boardBurst: {fileID: 8325107512831223767}
  introDelay: 1.4
  introLines:
  - 'SYSTEM: "Arrival: Chronos Lab. Local year: unstable."'
  - 'PLAYER: "The future. It''s... stuttering."'
  - 'SYSTEM: "Temporal charge 0%. Lab Chrono Core offline."'
  keycardObjective: Find a security keycard in the Archive
  keycardHint: Through the doorway east of the time machine
  keycardLines:
  - 'PLAYER: "A keycard. ''CORE HALL: AUTHORISED STAFF.'' Close enough."'
  doorObjective: Open the Core Hall door with the keycard
  doorHint: North-east corner of the Archive
  doorLines:
  - 'SYSTEM: "Access granted."'
  - 'SYSTEM: "Warning: temporal rifts detected. Contact costs time."'
  stabiliserObjective: Restart the Chrono Stabilisers
  stabiliserHint: One past the rift field, one in the Calibration Bay
  firstStabiliserLines:
  - 'PLAYER: "One stabiliser running. The core''s flickering..."'
  coreOnlineLines:
  - 'SYSTEM: "Chrono Core online. Timeline stabilising."'
  - 'PLAYER: "The rifts are closing! And the barrier to the concourse is open."'
  returnObjective: Return to the time machine
  returnHint: 'Shortcut: the barrier into the concourse'
  notReadyLines:
  - 'PLAYER: "Temporal charge 0%. I need the lab''s Chrono Core online."'
  notReadyWithCardLines:
  - 'PLAYER: "Temporal charge 0%. The Core Hall should be through that Archive."'
  repairedLines:
  - 'SYSTEM: "Charging from Chrono Core... 100%."'
  - 'SYSTEM: "Destination: home. The present."'
  - 'PLAYER: "Finally. No more falling."'
  boardObjective: Board the time machine
  endBanner: 'BACK TO THE PRESENT

    <size=36>Run complete</size>'
  hidePlayerOnBoard: 1
  restartRunAfter: 0
