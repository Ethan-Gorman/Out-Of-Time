  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62efa6fa6d0501a43b1b434031ae3219, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MedievalLevel
  introDelay: 0.6
  introLines:
  - Ugh... where am I? This isn't the Stone Age any more.
  - The time machine broke on the way here! It needs a Time Crystal to run.
  - There must be one somewhere inside this castle.
  startObjective: Find the Time Crystal in the castle
  crystalLines:
  - A Time Crystal! This should power the time machine.
  - Now back the way I came.
  returnObjective: Return to the time machine
  repairedLines:
  - It's working! The time machine is repaired.
  - 'Next stop: the Steampunk Era.'
  boardObjective: Board the time machine
  departLines:
  - Hmm... the dial won't go past the Medieval Era yet.
  nextEraBanner: 'INDUSTRIAL ERA

    <size=36>Coming soon</size>'
